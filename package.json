{
  "name": "@spatio-labs/spatio-ts",
  "version": "0.0.2",
  "description": "TypeScript SDK for the SpatioAPI. Generated from the official OpenAPI spec.",
  "license": "MIT",
  "homepage": "https://www.spatio.app/developers/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/spatio-labs/spatio-ts.git"
  },
  "bugs": {
    "url": "https://github.com/spatio-labs/spatio-ts/issues"
  },
  "keywords": [
    "spatio",
    "sdk",
    "api",
    "openapi",
    "typescript",
    "fetch"
  ],
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
